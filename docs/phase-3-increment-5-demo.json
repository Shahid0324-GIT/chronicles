      "id": "4948b221-369a-59a5-a943-9d4f443a7256",
      "entry_type": "lore",
      "graph_type": "LORE",
      "display_title": "Return by Death",
      "short_introduction": "Subaru possesses the power to return to the initial state of a parallel world upon his death.",
      "detailed_overview": "Natsuki Subaru recognizes that he has acquired the ability to return to the time and place where he began, which he terms \"Return by Death.\" Despite thinking it impossible, Subaru realizes that every time he dies, Return by Death causes him to return to the initial state from which he started.",
      "aliases": [
        "Return by Death"
      ],
      "original_names": [
        "Return by Death"
      ],
