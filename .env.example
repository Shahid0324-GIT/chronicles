DATABASE_URL=postgresql+asyncpg://atlas:atlas_local@127.0.0.1:5432/universe_atlas
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local research inference; Groq remains optional and content stays local by default.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
AI_PROVIDER_MODE=hybrid
AI_MAX_CONCURRENT_INFERENCES=1
AI_CLOUD_CONTENT_ALLOWED=false
AI_TIMEOUT_SECONDS=120
AI_MAX_ATTEMPTS=2
# Attempts include the initial call; invalid output gets a bounded corrective retry.
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_SECONDARY=
GROQ_MODEL=
AGENT_MAX_ITERATIONS=3
AGENT_MAX_SEARCH_QUERIES=10
AGENT_MAX_SOURCES=20
AGENT_MAX_MODEL_CALLS=48
AGENT_STAGE_MODEL_CALLS={"planning":3,"extraction":8,"identity_resolution":16,"relationship_analysis":3,"verification":24}
AGENT_MAX_JOB_SECONDS=900
RESEARCH_ALLOWED_HOSTS=["www.tv-tokyo.co.jp","re-zero-anime.jp","www.gutenberg.org"]
# Optional licensed episode-API demonstration: explicitly add api.tvmaze.com after
# configuring its registry permission/attribution (TVmaze API is CC BY-SA).
# A host allowlist alone does not grant source-processing permission.
RESEARCH_MAX_SOURCE_BYTES=500000
RESEARCH_MAX_SOURCE_CHARS=12000
RESEARCH_SOURCE_CACHE_HOURS=24
# Optional trusted loopback SearXNG; URL/text ingestion needs no search service.
SEARXNG_BASE_URL=http://127.0.0.1:8080
# tools/start-search.ps1 generates the ignored local secret without printing it.
SEARXNG_SECRET=
SEARXNG_TIMEOUT_SECONDS=20
SEARXNG_MIN_INTERVAL_SECONDS=30

# Automatic publication: strong claims always require at least two publisher families.
PROMOTION_MINIMUM_SOURCES=1
PROMOTION_STRONG_SOURCES=2

# Focused effort: per-job ceilings, never a required or sufficient number of sources.
# Omitted fields use ResearchPolicy defaults. The effective policy is persisted per job.
RESEARCH_FOCUSED_POLICY={"depth":"focused","max_passes":3,"max_follow_up_depth":2,"max_documents":12,"max_queries":8,"max_bytes":2000000,"max_model_calls":48,"max_tokens":150000,"max_seconds":900,"dossier_tokens":3500}
